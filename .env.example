# NAGARAKSHA — Environment Variables
# Copy this file to .env and configure your Supabase database credentials.
# NEVER commit .env to Git or expose database passwords in frontend code.

# Backend server port (default: 5001)
PORT=5001

# Supabase PostgreSQL Database Connection URL (Server-side ONLY)
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or direct: postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
